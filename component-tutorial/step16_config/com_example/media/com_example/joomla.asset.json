{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "com_example",
  "version": "1.0.0",
  "description": "Joomla CMS",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "com_example.map",
      "type": "preset",
      "dependencies": [
        "com_example.map#style",
        "com_example.map#script"
      ],
      "version": "1.0.0"
    },
    {
      "name": "com_example.map",
      "type": "style",
      "uri": "com_example/map.css",
      "dependencies": [
        "com_example.leaflet"
      ],
      "attributes": {},
      "version": "1.0.0"
    },
    {
      "name": "com_example.map",
      "type": "script",
      "uri": "com_example/map.js",
      "dependencies": [
        "com_example.leaflet",
        "core"
      ],
      "attributes": {
        "type": "module"
      },
      "version": "1.1.0"
    },
    {
      "name": "com_example.leaflet",
      "type": "script",
      "uri": "https://cdn.jsdelivr.net/npm/leaflet@2.0.0-alpha.1/dist/leaflet.js",
      "dependencies": [],
      "attributes": {
        "type": "module"
      },
      "version": "2.0.0-alpha.1"
    },
    {
      "name": "com_example.leaflet",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/leaflet@2.0.0-alpha.1/dist/leaflet.css",
      "dependencies": [],
      "attributes": {},
      "version": "2.0.0-alpha.1"
    }
  ]
}